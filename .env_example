# mongo
MONGO_INITDB_DATABASE=booksdb
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin

DATABASE_URL=mongodb://admin:admin@mongodb:27017/?authSource=admin

# postgres
POSTGRES_DB=booksdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/booksdb

DATABASE_URL=postgresql+psycopg2://admin:admin@postgres:5432/booksdb
REDIS_URL=redis://redis:6379/0